{
  "index_patterns": ["ssp-suricata-*", "ssp-zeek-*", "ssp-wazuh-*", "ssp-firewall-*", "ssp-waf-*", "ssp-ids-*", "ssp-proxy-*"],
  "priority": 100,
  "template": {
    "aliases": {
      "ssp-events": {}
    },
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "index.mapping.total_fields.limit": 3000,
      "index.refresh_interval": "5s"
    },
    "mappings": {
      "dynamic": true,
      "properties": {
        "@timestamp": { "type": "date" },
        "fields": {
          "properties": {
            "log_source": { "type": "keyword" },
            "branch":      { "type": "keyword" },
            "branch_site": { "type": "keyword" },
            "external":    { "type": "keyword" },
            "adapter":     { "type": "keyword" },
            "adapter_version": { "type": "keyword" }
          }
        },
        "event": {
          "properties": {
            "kind":     { "type": "keyword" },
            "category": { "type": "keyword" },
            "type":     { "type": "keyword" },
            "module":   { "type": "keyword" },
            "dataset":  { "type": "keyword" },
            "action":   { "type": "keyword" },
            "outcome":  { "type": "keyword" },
            "severity": { "type": "keyword" }
          }
        },
        "source": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "long" },
            "geo": {
              "properties": {
                "location":         { "type": "geo_point" },
                "continent_code":   { "type": "keyword" },
                "continent_name":   { "type": "keyword" },
                "country_iso_code": { "type": "keyword" },
                "country_name":     { "type": "keyword" },
                "region_iso_code":  { "type": "keyword" },
                "region_name":      { "type": "keyword" },
                "city_name":        { "type": "keyword" },
                "timezone":         { "type": "keyword" }
              }
            }
          }
        },
        "destination": {
          "properties": {
            "ip":   { "type": "ip" },
            "port": { "type": "long" },
            "geo": {
              "properties": {
                "location":         { "type": "geo_point" },
                "continent_code":   { "type": "keyword" },
                "continent_name":   { "type": "keyword" },
                "country_iso_code": { "type": "keyword" },
                "country_name":     { "type": "keyword" },
                "region_iso_code":  { "type": "keyword" },
                "region_name":      { "type": "keyword" },
                "city_name":        { "type": "keyword" },
                "timezone":         { "type": "keyword" }
              }
            }
          }
        },
        "network": {
          "properties": {
            "transport": { "type": "keyword" },
            "protocol":  { "type": "keyword" },
            "bytes":     { "type": "long" }
          }
        },
        "host": {
          "properties": {
            "name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "ip":   { "type": "ip" }
          }
        },
        "rule": {
          "properties": {
            "id":          { "type": "keyword" },
            "name":        { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "category":    { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "description": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 512 } } }
          }
        },
        "dns": {
          "properties": {
            "question": {
              "properties": {
                "name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } }
              }
            }
          }
        },
        "url": {
          "properties": {
            "domain": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "full":   { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } } }
          }
        },
        "tls": {
          "properties": {
            "client": {
              "properties": {
                "server_name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } }
              }
            }
          }
        },
        "file": {
          "properties": {
            "name": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "hash": {
              "properties": {
                "sha256": { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 128 } } }
              }
            }
          }
        },
        "observer": {
          "properties": {
            "name":    { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 256 } } },
            "type":    { "type": "keyword" },
            "vendor":  { "type": "keyword" },
            "product": { "type": "keyword" },
            "version": { "type": "keyword" }
          }
        },
        "ssp": {
          "properties": {
            "branch":      { "type": "keyword" },
            "branch_site": { "type": "keyword" },
            "external": {
              "properties": {
                "entry":  { "type": "keyword" },
                "peer":   { "type": "keyword" },
                "parsed": { "type": "object", "enabled": false },
                "json":   { "type": "object", "enabled": false }
              }
            }
          }
        },
        "log": {
          "properties": { "original": { "type": "text" } }
        }
      }
    }
  }
}
