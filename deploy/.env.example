# 本地运行时配置示例 —— 复制为 deploy/.env 后按需修改（deploy/.env 不入库）
#
#   cp deploy/.env.example deploy/.env      # 手工方式
#   make init                               # 推荐：不存在时自动生成随机口令
#
# 为什么要用 .env：仓库（含公开仓库）不应出现任何可用口令。compose 会自动读取
# 本文件所在目录（deploy/）下的 .env 做变量插值；宿主脚本由 scripts/_env.py 加载。

# ── 平台业务账号初始口令（scripts/init-db.py 种子：admin / ops / analyst / asset）──
# 留空则 init-db.py 拒绝执行（避免出现"默认口令即全部口令"）；make init 会自动填随机值。
SSP_DEFAULT_PASSWORD=
# 可选：为单个账号指定不同口令（不填则用上面的默认口令）
SSP_ADMIN_PASSWORD=
SSP_OPS_PASSWORD=
SSP_ANALYST_PASSWORD=
SSP_ASSET_PASSWORD=

# ── Arkime 管理账号（Viewer + portal 的 BFF 代理鉴权）──
ARKIME_ADMIN_USER=admin
ARKIME_ADMIN_PASSWORD=

# ── PostgreSQL（可选后端；仅在使用 make pg-* 时需要）──
POSTGRES_USER=ssp
POSTGRES_PASSWORD=
POSTGRES_DB=ssp
POSTGRES_PORT=5433

# ── 自建镜像版本（make build / make up 使用；改 Dockerfile 后 bump）──
SSP_IMAGE_TAG=2026.09
